<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SueldoHoras3381027.CuentaRegresiva20253446"
             Title="CuentaRegresiva20253446">
    <Grid RowDefinitions="Auto,*,Auto" Padding="30">

        <Label Grid.Row="0"
            Text="⏳ CUENTA REGRESIVA"
            FontSize="20"
            FontAttributes="Bold"
            HorizontalOptions="Center"
            Margin="0,20,0,0"
            CharacterSpacing="2" />

        <Label x:Name="LblNumero"
            Grid.Row="1"
            Text="10"
            FontSize="100"
            FontAttributes="Bold"
            HorizontalOptions="Center"
            VerticalOptions="Center" />

        <VerticalStackLayout Grid.Row="2" Spacing="15" Margin="0,0,0,30">

            <Button x:Name="BtnIniciar"
                 Text="Iniciar"
                 Clicked="BtnIniciar_Clicked" />

            <Button x:Name="BtnReiniciar"
                 Text="Reiniciar"
                 Clicked="BtnReiniciar_Clicked" />

        </VerticalStackLayout>

    </Grid>
</ContentPage>