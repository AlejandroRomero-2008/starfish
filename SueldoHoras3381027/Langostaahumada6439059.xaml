<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SueldoHoras3381027.Langostaahumada6439059"
             Title="Langostaahumada6439059">
    <Grid x:Name="MainLayout">
        <!-- Fondo Animado -->
        <Image x:Name="AnimatedBg"
               Source="background_pattern.png"
               Aspect="AspectFill"
               Opacity="0.12"
               HorizontalOptions="Fill"
               VerticalOptions="Fill" />

        <ScrollView>
            <VerticalStackLayout Padding="25" Spacing="20" HorizontalOptions="Center" MaximumWidthRequest="450">

                <!-- Logo Prominente -->
                <Border StrokeShape="RoundRectangle 70"
                        StrokeThickness="3"
                        Stroke="#D32F2F"
                        HeightRequest="140"
                        WidthRequest="140"
                        HorizontalOptions="Center"
                        Margin="0,10,0,0">
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,4" Radius="10" Opacity="0.3"/>
                    </Border.Shadow>
                    <Image Source="langosta.png"
                           Aspect="AspectFit"
                           Margin="12"/>
                </Border>

                <!-- Encabezado de Marca -->
                <VerticalStackLayout Spacing="4">
                    <Label Text="La Langosta Ahumada"
                           FontSize="26"
                           FontAttributes="Bold"
                           TextColor="#B71C1C"
                           HorizontalOptions="Center" />
                    <Label Text="Cotizador Oficial de Banquetes"
                           FontSize="14"
                           TextColor="Gray"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>

                <!-- Tarjeta de Formulario -->
                <Border StrokeShape="RoundRectangle 15"
                        Padding="20"
                        BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}">
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,2" Radius="8" Opacity="0.15"/>
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="15">
                        <Label Text="Número de Comensales:"
                               FontSize="14"
                               FontAttributes="Bold"/>

                        <Entry x:Name="TxtPersonas"
                               Placeholder="Ej. 250"
                               Keyboard="Numeric"
                               ClearButtonVisibility="WhileEditing"/>

                        <Button Text="Calcular Presupuesto"
                                Clicked="OnCalcularClicked"
                                BackgroundColor="#D32F2F"
                                TextColor="White"
                                FontAttributes="Bold"
                                CornerRadius="10"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Tarjeta de Resultados con Desglose -->
                <Border x:Name="ResultCard"
                        StrokeShape="RoundRectangle 15"
                        Padding="20"
                        IsVisible="False"
                        BackgroundColor="{AppThemeBinding Light=#FAFAFA, Dark=#2D2D2D}">
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,2" Radius="8" Opacity="0.15"/>
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="12">
                        <Label Text="Desglose de Cotización"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="#B71C1C"/>

                        <BoxView HeightRequest="1" Color="LightGray" />

                        <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="8">
                            <Label Grid.Row="0" Grid.Column="0" Text="Comensales:" />
                            <Label Grid.Row="0" Grid.Column="1" x:Name="LblPersonasCount" FontAttributes="Bold" />

                            <Label Grid.Row="1" Grid.Column="0" Text="Tarifa por Platillo:" />
                            <Label Grid.Row="1" Grid.Column="1" x:Name="LblCostoPlatillo" FontAttributes="Bold" />

                            <Label Grid.Row="2" Grid.Column="0" Text="Categoría Aplicada:" />
                            <Label Grid.Row="2" Grid.Column="1" x:Name="LblCategoria" FontAttributes="Bold" TextColor="#D32F2F"/>
                        </Grid>

                        <BoxView HeightRequest="1" Color="LightGray" />

                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="Total Estimado:" FontSize="18" FontAttributes="Bold" />
                            <Label Grid.Column="1" x:Name="LblTotal" FontSize="20" FontAttributes="Bold" TextColor="#2E7D32" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>