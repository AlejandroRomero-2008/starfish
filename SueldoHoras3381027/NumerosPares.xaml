<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SueldoHoras3381027.NumerosPares"
             Title="NumerosPares">
    
    <ScrollView>

    <VerticalStackLayout
            Padding="30"
            Spacing="20"
            VerticalOptions="Center">

        <Label 
                Text="Números pares del 0 al 100"
                FontSize="25"
                HorizontalOptions="Center"
                FontAttributes="Bold"/>

        <Button
                Text="Mostrar números pares"
                Clicked="MostrarPares_Clicked"/>

        <Label
                x:Name="ResultadoLabel"
                FontSize="20"
                HorizontalOptions="Center"/>

    </VerticalStackLayout>

    </ScrollView>
</ContentPage>